# Public site URL (used by sitemap/robots and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side SMTP — SendCert sends every certificate from this sender.
# End users never configure SMTP from the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SendCert
SMTP_FROM_EMAIL=certificates@sendcert.org
# Optional: recipients "Reply-To" lands here instead of SMTP_FROM_EMAIL.
SMTP_REPLY_TO=

# Monthly certificate cap for signed-in accounts
RATE_LIMIT_USER_PER_MONTH=300

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave empty to disable.
# The GA snippet is ALSO gated to production builds so dev never pollutes metrics.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (from the HTML tag option).
NEXT_PUBLIC_GSC_VERIFICATION=

# ----- Supabase (optional) -----
# Login + dashboard + certificate verification become available when these
# are set. The app fully works in guest mode without them.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — never expose to the client. Used for service-role inserts
# and reads (e.g. /verify/[id] page bypassing RLS).
SUPABASE_SERVICE_ROLE_KEY=

# Guest tier (logged-out IPs) gets a stricter monthly cap than logged-in users.
RATE_LIMIT_GUEST_PER_MONTH=100
