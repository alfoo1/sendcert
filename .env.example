# Public site URL (used by sitemap/robots and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-side SMTP — SendCert sends every certificate from this sender.
# End users never configure SMTP from the UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=SendCert
SMTP_FROM_EMAIL=certificates@sendcert.org
# Optional: recipients "Reply-To" lands here instead of SMTP_FROM_EMAIL.
SMTP_REPLY_TO=

# Monthly email cap per client IP (free tier guard-rail)
RATE_LIMIT_PER_MONTH=50

# Google Analytics 4 measurement ID (e.g. G-XXXXXXX). Leave empty to disable.
# The GA snippet is ALSO gated to production builds so dev never pollutes metrics.
NEXT_PUBLIC_GA_ID=

# Google Search Console verification token (from the HTML tag option).
NEXT_PUBLIC_GSC_VERIFICATION=
